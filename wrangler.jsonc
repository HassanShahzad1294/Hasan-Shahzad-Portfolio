{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hassan-portfolio",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  }
}